# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real secrets.
# Settings are loaded via pydantic-settings (see stock_ai.config, Task 1.2).

# --- Runtime ---
STOCK_AI_ENV=development          # development | production
STOCK_AI_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# --- Market data ---
# !!! このファイルは GitHub に公開されます。実際のキーは .env に書いてください !!!
JQUANTS_API_KEY=                  # J-Quants V2 API key (x-api-key)
EDINET_API_KEY=                   # EDINET API v2 subscription key (JP 法定開示)

# 立花証券・ｅ支店・ＡＰＩ。ｅ支店の利用設定画面で認証IDを生成し、同じ画面に
# 公開鍵を登録します（鍵は `tools\tachibana_probe.py keygen` で作れます）。
# 専用URLは利用設定画面の表示に合わせてください。版が上がると Prefix が変わり、
# 旧版は後継リリースの60日前後で停止します。
TACHIBANA_AUTH_ID=
# 日本株の株価をどこから取るか: jquants | tachibana
JP_PRICE_SOURCE=
# 日本株の財務諸表をどこから取るか: jquants | edinet
# edinet は有価証券報告書の「主要な経営指標等」から5期ぶんを読みます。無料ですが、
# 有報を探すのに1日1リクエストで400日ぶん走査します（銘柄をまたいで使い回されます）。
JP_STATEMENT_SOURCE=
# 日本株の銘柄一覧（市場区分・業種）をどこから取るか: jquants | tachibana
# **上の2つはここに効きません。** 価格と財務を移しても、銘柄一覧だけ J-Quants を
# 叩き続けます。解約するなら3つとも切り替えてください（docs/JQUANTS_EXIT.md）。
JP_UNIVERSE_SOURCE=
TACHIBANA_API_VERSION=            # 空ならその日の既定。v4r10 は 2026-08-29 公開、
                                  # v4r9 は 2026-09-27 停止
TACHIBANA_BASE_URL=               # 専用URLを直接指定したいときだけ。通常は空でよい
# 秘密鍵とセッションの置き場所。空なら tachibana/private.pem と
# tachibana/session.json。整理前は直下（tachibana_private.pem）にあり、
# そちらにしか無ければコードはそちらを読んで警告する。
TACHIBANA_PRIVATE_KEY=
TACHIBANA_SESSION_FILE=

# --- AI providers (Phase 6) ---
# Which provider the AI commands use when --provider is not given. Blank means
# 'dummy', which echoes prompts instead of calling a model: it needs no key and
# costs nothing, but a dummy run still lists alerts and names symbols, so it
# looks like a cheap real run rather than a fake one. Set this to 'claude' once
# a key is in place.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Which Claude model the AI commands call. Blank uses the built-in default
# (claude-opus-5). A smaller model costs a fraction of the same run:
# claude-haiku-4-5 is $1/$5 per million tokens against opus's $5/$25.
# 'stock-ai ai-cost' prices whatever is set here.
ANTHROPIC_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Brokerage: moomoo OpenD ---
# moomoo には API キーがありません。認証は OpenD (このPCで動かすゲートウェイ)に
# moomoo証券のIDでログインすることで行います。手順は docs/MOOMOO_OPEND.md を参照。
# 接続確認: moomoo接続確認.bat  /  uv run stock-ai moomoo-check
MOOMOO_OPEND_HOST=127.0.0.1       # ローカル以外に向けないこと(ログイン済み口座が外部に開きます)
MOOMOO_OPEND_PORT=11111           # OpenD の設定画面と同じ番号にする
MOOMOO_SECURITY_FIRM=FUTUJP       # moomoo証券(日本)は FUTUJP / 米国法人は FUTUINC
MOOMOO_TRD_MARKET=JP              # JP | US
MOOMOO_TRD_ENV=SIMULATE           # SIMULATE(模擬) | REAL(実口座)
# 取引暗証番号(6桁)。ログインパスワードとは別物です。
# 空のままなら実口座はロックされたままになります(既定はそれで安全)。
MOOMOO_TRADE_PASSWORD=

# --- Notifications (Phase 8) ---
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 自動売買の運用モニタ(参照先は別リポジトリ) ---
# ダッシュボードの「自動売買 運用」画面は、自分では売買せず、WSL 上で動いている
# 自動売買リポジトリ(正典)を読みに行きます。帳簿・シグナル・キルスイッチは
# すべてそちらが正典で、stock-ai 側に複製はしません(docs/OPS.md)。
# ここを設定にしてあるのは、正典が引っ越したときに黙って古いコピーを読み続ける
# 事故を防ぐため — 実際に一度、Desktop の古いコピーと正典が分岐しています。
OPS_WSL_DISTRO=Ubuntu-24.04        # wsl -l -q に出る名前
OPS_REPO_PATH=/home/hayashida/test # WSL の中から見たパス(Windowsのパスではない)
OPS_REPO_PYTHON=.venv/bin/python   # 正典リポジトリからの相対パスでよい
