# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- uv / venv ---
.venv/
uv.lock.bak

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
