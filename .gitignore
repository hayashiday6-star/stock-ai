# --- Data / logs / DB (runtime artifacts) ---
logs/*
!logs/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
*.db-journal
# プローブが書き出す生の応答（株価のみ。個人情報は含まない）。
tachibana_history*.json
# 当日の仮想URL。復号済みなので、これ自体が資格情報。
tachibana_session*.json

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
