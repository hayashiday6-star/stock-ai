# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- uv / venv ---
.venv/
uv.lock.bak

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# --- Secrets & local config ---
.env
.env.*
!.env.example
設定.txt
# 立花の仮想URLを復号する秘密鍵。.env と同じ扱い。
*.pem
tachibana_private*
# 立花関係のファイルはこのフォルダにまとめる（秘密鍵・当日のセッション・
# 登録用の公開鍵・プローブの生出力）。README だけ追跡する。
tachibana/*
!tachibana/README.md

# 米国株のシンボル一覧。README と docs/ACCUMULATION.md が
# `--symbols-file us.txt` として案内している、利用者が自分で置くファイル。
# 中身は各自の対象銘柄なので追跡しない。
us.txt

# --- Data / logs / DB (runtime artifacts) ---
# data/universe_snapshots/ と data/tachibana_snapshots/ は**追跡する**。
# 上場していた会社の名簿で、解約後どこからも作り直せない。
logs/*
!logs/.gitkeep
data/*.db
data/*.sqlite
data/*.sqlite3
*.db-journal
# 整理前の置き場所（プロジェクト直下）。移し終えるまで無視し続ける。
tachibana_history*.json
tachibana_session*.json
tachibana_public*.txt
tachibana_master*.json
# EDINET から落とした書類本体（公開情報だが、生成物なので追跡しない）。
edinet_probe/

# --- Diagnostic reports (regenerated on demand; may name an account) ---
verify-output.txt
verify-ai-output.txt
moomoo-output.txt

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
